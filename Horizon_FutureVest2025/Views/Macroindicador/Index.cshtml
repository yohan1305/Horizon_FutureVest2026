@model List<Application.ViewModels.Macroindicador.MacroindicadorViewModel>
@{
    ViewData["Title"] = "Macroindicadores";
}

<div class="row">
    <div class="text-center">
        <h1 class="display-4">Macroindicadores</h1>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12 col-md-3">
        <a class="btn btn-outline-success" asp-controller="Macroindicador" asp-action="Create">+ Nuevo macroindicador</a>
    </div>
</div>

<div class="row mt-2">
    @if (Model.Count == 0)
    {
        <div class="text-center">
            <h4 class="display-6">No hay macroindicadores registrados</h4>
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="col-12 col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <h6 class="card-subtitle">Peso: @item.Peso</h6>
                        <p class="card-text mt-2">¿Es mejor más alto?: @(item.EsMejorMasAlto ? "Sí" : "No")</p>
                        <div class="mt-2">
                            <a class="btn btn-outline-warning float-end" asp-controller="Macroindicador" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                            <a class="btn btn-outline-danger float-end me-2" asp-controller="Macroindicador" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>