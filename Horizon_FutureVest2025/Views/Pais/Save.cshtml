@model Application.ViewModels.Pais.SavePaisViewModel
@{
    bool editMode = ViewBag.EditMode ?? false;
    ViewData["Title"] = "Guardar país";
}

<div class="col-12 col-md-6 offset-md-3">
    <div class="card">
        <div class="card-header bg-success text-light">
            <h5 class="text-center">@(editMode ? "Editar - " + Model.Name : "Nuevo país")</h5>
        </div>
        <div class="card-body">
            <form asp-controller="Pais" asp-action="@(editMode ? "Edit" : "Create")" method="POST">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Nombre del país:</label>
                    <input class="form-control" asp-for="Name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CodigoIso" class="form-label">Código ISO:</label>
                    <input class="form-control" asp-for="CodigoIso" />
                    <span asp-validation-for="CodigoIso" class="text-danger"></span>
                </div>

                <div>
                    <button type="submit" class="btn btn-outline-primary float-end">Guardar</button>
                    <a asp-controller="Pais" asp-action="Index" class="btn btn-outline-warning float-end me-2">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>