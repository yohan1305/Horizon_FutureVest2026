@model Application.ViewModels.IndicadorPorPais.DeleteIndicadorPorPaisViewModel
@{
    ViewData["Title"] = "Eliminar indicador";
}

<div class="col-12 col-md-6 offset-md-3">
    <div class="card">
        <div class="card-header bg-danger text-light">
            <h4 class="text-center">¿Está seguro que desea eliminar el indicador de @Model.NombreMacroindicador para @Model.NombrePais en el año @Model.Anio?</h4>
        </div>
        <div class="card-body">
            <form asp-controller="IndicadorPorPais" asp-action="Delete" method="POST">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-center">
                    <button type="submit" class="btn btn-danger me-2">Eliminar</button>
                    <a asp-controller="IndicadorPorPais" asp-action="Index" class="btn btn-outline-warning">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>