@model Application.ViewModels.Simulacion.SimulacionRankingViewModel
@{
    ViewData["Title"] = "Simulación de Ranking";
}

<h2 class="text-center mb-4">Simulacion Ranking</h2>

<!-- Botón para agregar nuevo macroindicador -->
@if (Model.MacroindicadoresSimulados.Sum(m => m.PesoSimulacion) < 1)
{
    <a asp-action="Agregar" class="btn btn-primary mb-3">Agregar Macroindicador</a>
}
else
{
    <div class="alert alert-warning">Ya se ha alcanzado el peso total de 1. No se pueden agregar más macroindicadores.</div>
}

<!-- Listado de macroindicadores simulados -->
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Peso</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.MacroindicadoresSimulados)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.PesoSimulacion</td>
                <td>
                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Formulario para seleccionar año y simular ranking -->
<form asp-action="SimularRanking" method="post">
    <div class="form-group">
        <label for="AnioSeleccionado">Año</label>
        <select asp-for="AnioSeleccionado" asp-items="@(new SelectList(Model.AñosDisponibles))" class="form-control"></select>
    </div>
    <button type="submit" class="btn btn-success mt-2">Simular Ranking</button>
</form>

<!-- Mensaje si aplica -->
@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-info mt-3">@Model.Mensaje</div>
}

<!-- Resultados del ranking -->
@if (Model.ResultadoRanking.Any())
{
    <h3 class="mt-4">Resultado de la Simulación</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>País</th>
                <th>Código ISO</th>
                <th>Scoring</th>
                <th>Tasa de Retorno</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.ResultadoRanking)
            {
                <tr>
                    <td>@r.NombrePais</td>
                    <td>@r.CodigoIso</td>
                    <td>@r.Scoring.ToString("F4")</td>
                    <td>@r.TasaRetorno.ToString("F2")%</td>
                </tr>
            }
        </tbody>
    </table>
}