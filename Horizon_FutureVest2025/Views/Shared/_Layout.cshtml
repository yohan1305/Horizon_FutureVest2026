<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HorizonFutureVest2025</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Horizon_FutureVest2025.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-lg">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-graph-up-arrow"></i>
                    HorizonFutureVest2025
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav ms-auto gap-2">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill"></i> Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Pais" asp-action="Index">
                                <i class="bi bi-globe-americas"></i> Países
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Macroindicador" asp-action="Index">
                                <i class="bi bi-bar-chart-line-fill"></i> Macroindicadores
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="IndicadorPorPais" asp-action="Index">
                                <i class="bi bi-clipboard-data-fill"></i> Indicadores
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ConfiguracionRetorno" asp-action="Index">
                                <i class="bi bi-cash-stack"></i> Tasa Retorno
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Simulacion" asp-action="Index">
                                <i class="bi bi-cpu-fill"></i> Simulador
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto">
        <div class="container text-center">
            <i class="bi bi-code-slash"></i>
            © 2025 - HorizonFutureVest2025 | Yohansel Mieses
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>